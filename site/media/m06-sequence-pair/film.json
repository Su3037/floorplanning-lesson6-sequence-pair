      {
       "start": 3.4,
       "end": 7.533,
       "text": "Five rectangles, fixed sizes, no rotation.",
       "sceneId": "k01-problem"
      },
      {
       "start": 7.533,
       "end": 12.556,
       "text": "Fixed outline 10 × 8; origin lower-left, y up.",
       "sceneId": "k01-problem"
      },
      {
       "start": 12.556,
       "end": 17.156,
       "text": "Given pos and neg, find every block's coordinates.",
       "sceneId": "k01-problem"
      },
      {
       "start": 17.556,
       "end": 22.356,
       "text": "For each pair, compare its order in the two permutations.",
       "sceneId": "k02-rule"
      },
      {
       "start": 22.356,
       "end": 25.956,
       "text": "First in both: on the left.",
       "sceneId": "k02-rule"
      },
      {
       "start": 25.956,
       "end": 30.311,
       "text": "First in pos, second in neg: below.",
       "sceneId": "k02-rule"
      },
      {
       "start": 30.311,
       "end": 35.778,
       "text": "If a book says 'above', swap the two sequences.",
       "sceneId": "k02-rule"
      },
      {
       "start": 36.178,
       "end": 41.378,
       "text": "Ten pairs, each relation written down.",
       "sceneId": "k03-graphs"
      },
      {
       "start": 41.378,
       "end": 45.378,
       "text": "Left/right goes into H, below/above into V.",
       "sceneId": "k03-graphs"
      },
      {
       "start": 45.378,
       "end": 49.978,
       "text": "Each pair goes into one graph: six in H, four in V.",
       "sceneId": "k03-graphs"
      },
      {
       "start": 50.378,
       "end": 55.978,
       "text": "In pos order, compute x block by block.",
       "sceneId": "k04-dpx"
      },
      {
       "start": 55.978,
       "end": 60.978,
       "text": "E's predecessors A, B, C: candidates 3, 5, 7.",
       "sceneId": "k04-dpx"
      },
      {
       "start": 60.978,
       "end": 66.0,
       "text": "Add the predecessor's width; the maximum, x[E] = 7.",
       "sceneId": "k04-dpx"
      },
      {
       "start": 66.0,
       "end": 70.4,
       "text": "D has no horizontal predecessor: x[D] = 0.",
       "sceneId": "k04-dpx"
      },
      {
       "start": 70.8,
       "end": 75.4,
       "text": "Now y: D's vertical predecessors are the other four.",
       "sceneId": "k05-dpy"
      },
      {
       "start": 75.4,
       "end": 79.978,
       "text": "The tallest is B: y[D] = 0 + 3 = 3.",
       "sceneId": "k05-dpy"
      },
      {
       "start": 79.978,
       "end": 83.578,
       "text": "The other four stay at y = 0.",
       "sceneId": "k05-dpy"
      },
      {
       "start": 83.978,
       "end": 88.978,
       "text": "Then answer four separate questions.",
       "sceneId": "k06-metrics"
      },
      {
       "start": 88.978,
       "end": 92.889,
       "text": "Box 9 × 4, inside 10 × 8.",
       "sceneId": "k06-metrics"
      },
      {
       "start": 92.889,
       "end": 97.489,
       "text": "Outline unused and density are constants.",
       "sceneId": "k06-metrics"
      },
      {
       "start": 97.889,
       "end": 102.689,
       "text": "Identical permutations: one row, 12 wide.",
       "sceneId": "k07-overflow"
      },
      {
       "start": 102.689,
       "end": 107.044,
       "text": "Reverse neg: one column, 10 tall.",
       "sceneId": "k07-overflow"
      },
      {
       "start": 107.044,
       "end": 111.444,
       "text": "Both valid and overlap-free, neither fits.",
       "sceneId": "k07-overflow"
      },
      {
       "start": 111.844,
       "end": 115.978,
       "text": "Same order is left/right; opposite is below/above.",
       "sceneId": "k08-summary"
      },
      {
       "start": 115.978,
       "end": 119.667,
       "text": "One edge per pair, all along pos.",
       "sceneId": "k08-summary"
      },
      {
       "start": 119.667,
       "end": 124.467,
       "text": "A coordinate is a longest path: add the size, take the max.",
       "sceneId": "k08-summary"
      },
      {
       "start": 124.467,
       "end": 129.467,
       "text": "No overlap is guaranteed; fit is checked separately.",
       "sceneId": "k08-summary"
      }
