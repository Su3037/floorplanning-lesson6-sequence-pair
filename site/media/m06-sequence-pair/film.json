     "transcript": [
      {
       "start": 3.4,
       "end": 7.533,
       "text": "五个矩形块，固定尺寸，不旋转。",
       "sceneId": "k01-problem"
      },
      {
       "start": 7.533,
       "end": 12.556,
       "text": "固定边界 10 × 8；原点在左下，y 向上。",
       "sceneId": "k01-problem"
      },
      {
       "start": 12.556,
       "end": 17.156,
       "text": "给定 pos 与 neg，求每块的坐标。",
       "sceneId": "k01-problem"
      },
      {
       "start": 17.556,
       "end": 22.356,
       "text": "每一对块，看它们在两个排列里的先后。",
       "sceneId": "k02-rule"
      },
      {
       "start": 22.356,
       "end": 25.956,
       "text": "两边都在前：在左边。",
       "sceneId": "k02-rule"
      },
      {
       "start": 25.956,
       "end": 30.311,
       "text": "pos 在前、neg 在后：在下边。",
       "sceneId": "k02-rule"
      },
      {
       "start": 30.311,
       "end": 35.778,
       "text": "别的教材若规定为“上”，就把两个序列交换。",
       "sceneId": "k02-rule"
      },
      {
       "start": 36.178,
       "end": 41.378,
       "text": "十对块，逐对写出关系。",
       "sceneId": "k03-graphs"
      },
      {
       "start": 41.378,
       "end": 45.378,
       "text": "左右进 H，上下进 V。",
       "sceneId": "k03-graphs"
      },
      {
       "start": 45.378,
       "end": 49.978,
       "text": "每对只进一张图：H 六条，V 四条。",
       "sceneId": "k03-graphs"
      },
      {
       "start": 50.378,
       "end": 55.978,
       "text": "按 pos 的顺序，逐块算 x。",
       "sceneId": "k04-dpx"
      },
      {
       "start": 55.978,
       "end": 60.978,
       "text": "E 的前驱 A、B、C：候选 3、5、7。",
       "sceneId": "k04-dpx"
      },
      {
       "start": 60.978,
       "end": 66.0,
       "text": "加的是前驱的宽；取最大，x[E] = 7。",
       "sceneId": "k04-dpx"
      },
      {
       "start": 66.0,
       "end": 70.4,
       "text": "D 没有水平前驱：x[D] = 0。",
       "sceneId": "k04-dpx"
      },
      {
       "start": 70.8,
       "end": 75.4,
       "text": "再算 y：D 的竖直前驱是另外四块。",
       "sceneId": "k05-dpy"
      },
      {
       "start": 75.4,
       "end": 79.978,
       "text": "最高的是 B：y[D] = 0 + 3 = 3。",
       "sceneId": "k05-dpy"
      },
      {
       "start": 79.978,
       "end": 83.578,
       "text": "其余四块都在 y = 0。",
       "sceneId": "k05-dpy"
      },
      {
       "start": 83.978,
       "end": 88.978,
       "text": "算完后，四个问题分开回答。",
       "sceneId": "k06-metrics"
      },
      {
       "start": 88.978,
       "end": 92.889,
       "text": "包围盒 9 × 4，装进 10 × 8。",
       "sceneId": "k06-metrics"
      },
      {
       "start": 92.889,
       "end": 97.489,
       "text": "边界空余与密度是常量，不随排列变。",
       "sceneId": "k06-metrics"
      },
      {
       "start": 97.889,
       "end": 102.689,
       "text": "两个排列相同：五块排成一行，宽 12。",
       "sceneId": "k07-overflow"
      },
      {
       "start": 102.689,
       "end": 107.044,
       "text": "neg 反过来：叠成一列，高 10。",
       "sceneId": "k07-overflow"
      },
      {
       "start": 107.044,
       "end": 111.444,
       "text": "都合法、不重叠，却都装不下。",
       "sceneId": "k07-overflow"
      },
      {
       "start": 111.844,
       "end": 115.978,
       "text": "次序相同是左右，相反是上下。",
       "sceneId": "k08-summary"
      },
      {
       "start": 115.978,
       "end": 119.667,
       "text": "每对一条边，都顺着 pos。",
       "sceneId": "k08-summary"
      },
      {
       "start": 119.667,
       "end": 124.467,
       "text": "坐标是最长路径：加前驱尺寸，取最大。",
       "sceneId": "k08-summary"
      },
      {
       "start": 124.467,
       "end": 129.467,
       "text": "不重叠有保证，装得下要另查。",
       "sceneId": "k08-summary"
      }
