     "transcript": [
      {
       "start": 3.4,
       "end": 8.0,
       "text": "E 的每条入边都是一个下界。",
       "sceneId": "a01-longest"
      },
      {
       "start": 8.0,
       "end": 12.4,
       "text": "把下界画在数轴上：3、5、7。",
       "sceneId": "a01-longest"
      },
      {
       "start": 12.4,
       "end": 17.2,
       "text": "同时满足三条，x[E] 只能在 7 以右。",
       "sceneId": "a01-longest"
      },
      {
       "start": 17.2,
       "end": 21.8,
       "text": "最小的可行值就是最长路径。",
       "sceneId": "a01-longest"
      },
      {
       "start": 22.2,
       "end": 27.0,
       "text": "三块：A 在 C 下边，A、C 都在 B 左边。",
       "sceneId": "a02-max"
      },
      {
       "start": 27.0,
       "end": 32.6,
       "text": "取最小 2：只满足 C 那一条，B 压在 A 上。",
       "sceneId": "a02-max"
      },
      {
       "start": 32.6,
       "end": 36.6,
       "text": "取最大 3：两条都满足。",
       "sceneId": "a02-max"
      },
      {
       "start": 37.0,
       "end": 40.6,
       "text": "约束图会不会有环？",
       "sceneId": "a03-acyclic"
      },
      {
       "start": 40.6,
       "end": 44.8,
       "text": "给每块标上它在 pos 里的位置。",
       "sceneId": "a03-acyclic"
      },
      {
       "start": 44.8,
       "end": 49.4,
       "text": "左边和下边，都要求在 pos 里在前。",
       "sceneId": "a03-acyclic"
      },
      {
       "start": 49.4,
       "end": 54.0,
       "text": "沿边走，位置只增不减：没有环。",
       "sceneId": "a03-acyclic"
      },
      {
       "start": 54.4,
       "end": 59.2,
       "text": "把全部 14,400 个序列对都算一遍。",
       "sceneId": "a04-fit"
      },
      {
       "start": 59.2,
       "end": 62.2,
       "text": "没有一个重叠。",
       "sceneId": "a04-fit"
      },
      {
       "start": 62.2,
       "end": 66.0,
       "text": "但 720 个装不进 10 × 8。",
       "sceneId": "a04-fit"
      },
      {
       "start": 66.0,
       "end": 71.267,
       "text": "边界空余与密度从不变化，不能用来比较。",
       "sceneId": "a04-fit"
      },
      {
       "start": 71.667,
       "end": 76.689,
       "text": "pos 中交换 E、D：E–D 的关系变了。",
       "sceneId": "a05-twins"
      },
      {
       "start": 76.689,
       "end": 81.489,
       "text": "坐标却完全相同：两种关系都成立。",
       "sceneId": "a05-twins"
      },
      {
       "start": 81.489,
       "end": 86.289,
       "text": "反过来，包围盒相同，布局可以不同。",
       "sceneId": "a05-twins"
      },
      {
       "start": 86.289,
       "end": 91.978,
       "text": "14,400 个序列对，只有 9,056 种布局。",
       "sceneId": "a05-twins"
      },
      {
       "start": 92.378,
       "end": 96.578,
       "text": "有的教材把“下”定义成“上”。",
       "sceneId": "a06-mirror"
      },
      {
       "start": 96.578,
       "end": 102.489,
       "text": "那只是竖直方向的镜像：交换 pos 与 neg 即可。",
       "sceneId": "a06-mirror"
      },
      {
       "start": 102.489,
       "end": 106.089,
       "text": "读资料时先看约定。",
       "sceneId": "a06-mirror"
      },
      {
       "start": 106.489,
       "end": 112.622,
       "text": "代价：n(n−1)/2 对，两遍 DP，O(n²)。",
       "sceneId": "a07-cost"
      },
      {
       "start": 112.622,
       "end": 116.422,
       "text": "建图与 DP 是主要的工作。",
       "sceneId": "a07-cost"
      },
      {
       "start": 116.422,
       "end": 121.022,
       "text": "搜索靠交换；排列对的数量增长极快。",
       "sceneId": "a07-cost"
      },
      {
       "start": 121.422,
       "end": 125.689,
       "text": "最长路径给出最紧凑的坐标。",
       "sceneId": "a08-summary"
      },
      {
       "start": 125.689,
       "end": 129.6,
       "text": "取最大，因为每条边都要成立。",
       "sceneId": "a08-summary"
      },
      {
       "start": 129.6,
       "end": 133.067,
       "text": "边顺着 pos，所以无环。",
       "sceneId": "a08-summary"
      },
      {
       "start": 133.067,
       "end": 136.467,
       "text": "不重叠不等于装得下。",
       "sceneId": "a08-summary"
      },
      {
       "start": 136.467,
       "end": 140.467,
       "text": "一种布局，可以有多种写法。",
       "sceneId": "a08-summary"
      }
     ],
